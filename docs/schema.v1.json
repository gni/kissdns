{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ipv4": {
      "type": "string",
      "description": "IPv4 address",
      "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$"
    },
    "ipv6": {
      "type": "string",
      "description": "IPv6 address",
      "pattern": "^([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}$|^([0-9a-fA-F]{1,4}:){1,7}:[0-9a-fA-F]{0,4}$|^::(?:[0-9a-fA-F]{1,4}:){0,6}[0-9a-fA-F]{1,4}$"
    },
    "domain_name": {
      "type": "string",
      "description": "Domain name (may contain wildcard *)",
      "pattern": "^[a-zA-Z0-9*.-]+\\.[a-zA-Z]{2,}$"
    },
    "ip_address": {
      "oneOf": [
        { "$ref": "#/definitions/ipv4" },
        { "$ref": "#/definitions/ipv6" }
      ],
      "description": "IP address (IPv4 or IPv6)"
    },
    "dns_record": {
      "type": "object",
      "description": "DNS record: hostname -> IP address",
      "additionalProperties": {
        "$ref": "#/definitions/ip_address"
      },
      "minProperties": 1
    },
    "dns_server": {
      "oneOf": [
        { "$ref": "#/definitions/ipv4" },
        { "$ref": "#/definitions/ipv6" }
      ],
      "description": "DNS server (IPv4 or IPv6)",
      "examples": ["8.8.8.8", "1.1.1.1", "2001:4860:4860::8888"]
    },
    "domain_with_wildcard": {
      "type": "object",
      "description": "DNS record",
      "additionalProperties": {
        "$ref": "#/definitions/ip_address"
      },
      "propertyNames": {
        "$ref": "#/definitions/domain_name"
      },
      "minProperties": 1
    }
  },
  "type": "object",
  "properties": {
    "records": {
      "oneOf": [
        { "$ref": "#/definitions/dns_record" },
        { "$ref": "#/definitions/domain_with_wildcard" }
      ],
      "description": "DNS records (A/AAAA records)"
    },
    "fallback_dns": {
      "$ref": "#/definitions/dns_server"
    }
  },
  "required": ["records", "fallback_dns"],
  "additionalProperties": false
}